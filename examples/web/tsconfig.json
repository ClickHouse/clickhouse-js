{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "pretty": true,
    "noEmitOnError": true,
    "strict": true,
    "resolveJsonModule": true,
    "removeComments": false,
    "sourceMap": true,
    "noFallthroughCasesInSwitch": true,
    "useDefineForClassFields": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "importHelpers": false,
    "lib": ["ES2022", "ESNext.Disposable", "DOM"],
    "types": []
  },
  "include": ["./**/*.ts"],
  // TODO: stop excluding coding/external_data.ts once a @clickhouse/client-web
  //  release with `external_data` support is published to npm.
  "exclude": [
    "node_modules",
    "vitest.config.ts",
    "vitest.setup.ts",
    "coding/external_data.ts"
  ]
}
